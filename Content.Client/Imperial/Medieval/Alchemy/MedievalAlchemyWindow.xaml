<controls:FancyWindow xmlns="https://spacestation14.io" xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client" MinSize="620 670" Title="{Loc 'medieval-alchemy-window-title'}">
  <TabContainer Name="Tabs" Margin="5 5 7 5">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="5" SeparationOverride="10">
      <!-- Input container info -->
      <BoxContainer Orientation="Horizontal">
        <Label Text="{Loc 'chem-master-window-container-label'}"/>
        <Control HorizontalExpand="True"/>
        <Button MinSize="80 0" Name="InputEjectButton" Access="Public" Text="{Loc 'chem-master-window-eject-button'}"/>
      </BoxContainer>
      <PanelContainer VerticalExpand="True" MinSize="0 200">
        <PanelContainer.PanelOverride>
          <gfx:StyleBoxFlat BackgroundColor="#1B1B1E"/>
        </PanelContainer.PanelOverride>
        <ScrollContainer HorizontalExpand="True" MinSize="0 200">
          <!-- Initially empty, when server sends state data this will have container contents and fill volume.-->
          <BoxContainer Name="InputContainerInfo" Orientation="Vertical" Margin="4" HorizontalExpand="True">
            <Label Text="{Loc 'chem-master-window-no-container-loaded-text'}"/>
          </BoxContainer>
        </ScrollContainer>
      </PanelContainer>
      <!-- Padding -->
      <Control MinSize="0 10"/>
      <!-- Buffer -->
      <BoxContainer Orientation="Horizontal">
        <Label Text="{Loc 'chem-master-window-buffer-text'}"/>
        <Control HorizontalExpand="True"/>
        <Button MinSize="80 0" Name="BufferTransferButton" Access="Public" Text="{Loc 'chem-master-window-transfer-button'}" ToggleMode="True" StyleClasses="OpenRight"/>
        <Button MinSize="80 0" Name="BufferSortButton" Access="Public" Text="{Loc 'chem-master-window-sort-type-none'}" StyleClasses="OpenBoth"/>
        <Button MinSize="80 0" Name="BufferDiscardButton" Access="Public" Text="{Loc 'chem-master-window-discard-button'}" ToggleMode="True" StyleClasses="OpenLeft"/>
      </BoxContainer>
      <!-- Buffer info -->
      <PanelContainer VerticalExpand="True" MinSize="0 200">
        <PanelContainer.PanelOverride>
          <gfx:StyleBoxFlat BackgroundColor="#1B1B1E"/>
        </PanelContainer.PanelOverride>
        <ScrollContainer HorizontalExpand="True" MinSize="0 200">
          <!-- Buffer reagent list -->
          <BoxContainer Name="BufferInfo" Orientation="Vertical" Margin="4" HorizontalExpand="True">
            <Label Text="{Loc 'chem-master-window-buffer-empty-text'}"/>
          </BoxContainer>
        </ScrollContainer>
      </PanelContainer>
    </BoxContainer>
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="5" SeparationOverride="10">
      <!-- Output container info -->
      <BoxContainer Orientation="Horizontal">
        <Label Text="{Loc 'chem-master-window-container-label'}"/>
        <Control HorizontalExpand="True"/>
        <Button MinSize="80 0" Name="OutputEjectButton" Access="Public" Text="{Loc 'chem-master-window-eject-button'}"/>
      </BoxContainer>
      <PanelContainer VerticalExpand="True" MinSize="0 200">
        <PanelContainer.PanelOverride>
          <gfx:StyleBoxFlat BackgroundColor="#1B1B1E"/>
        </PanelContainer.PanelOverride>
        <ScrollContainer HorizontalExpand="True" MinSize="0 200">
          <!-- Initially empty, when server sends state data this will have container contents and fill volume.-->
          <BoxContainer Name="OutputContainerInfo" Orientation="Vertical" Margin="4" HorizontalExpand="True">
            <Label Text="{Loc 'chem-master-window-no-container-loaded-text'}"/>
          </BoxContainer>
        </ScrollContainer>
      </PanelContainer>
      <!-- Padding -->
      <Control MinSize="0 10"/>
      <!-- Packaging -->
      <BoxContainer Orientation="Horizontal">
        <Label Text="{Loc 'chem-master-window-packaging-text'}"/>
        <Control HorizontalExpand="True"/>
        <Label Text="{Loc 'chem-master-window-buffer-label'}"/>
        <Label Name="BufferCurrentVolume" StyleClasses="LabelSecondaryColor"/>
      </BoxContainer>
      <!-- Wrap the packaging info-->
      <PanelContainer>
        <PanelContainer.PanelOverride>
          <gfx:StyleBoxFlat BackgroundColor="#1B1B1E"/>
        </PanelContainer.PanelOverride>
        <!-- Packaging Info -->
        <BoxContainer Orientation="Vertical" Margin="4" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="5">
          <!-- Label for output -->
          <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'chem-master-current-text-label'}"/>
            <Control HorizontalExpand="True" MinSize="50 0"/>
            <LineEdit Name="LabelLineEdit" SetWidth="455"/>
          </BoxContainer>
          <!-- Pills Type Buttons -->
          <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'chem-master-window-pill-type-label'}"/>
            <Control HorizontalExpand="True" MinSize="50 0"/>
            <GridContainer Name="Grid" Columns="10">
              <!-- Pills type buttons are generated in the code -->
            </GridContainer>
          </BoxContainer>
          <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'chem-master-window-pills-label'}"/>
            <Control HorizontalExpand="True" MinSize="50 0"/>
            <Label Text="{Loc 'chem-master-window-pills-number-label'}" Margin="5 0 0 0" StyleClasses="LabelSecondaryColor"/>
            <SpinBox MinSize="100 0" Name="PillNumber" Access="Public" Value="0"/>
            <Label Text="{Loc 'chem-master-window-dose-label'}" Margin="5 0 0 0" StyleClasses="LabelSecondaryColor"/>
            <SpinBox MinSize="100 0" Name="PillDosage" Access="Public" Value="1"/>
            <Button MinSize="80 0" Name="CreatePillButton" Access="Public" Text="{Loc 'chem-master-window-create-button'}"/>
          </BoxContainer>
          <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'chem-master-window-bottles-label'}"/>
            <Control HorizontalExpand="True" MinSize="50 0"/>
            <Label Text="{Loc 'chem-master-window-dose-label'}" Margin="5 0 0 0" StyleClasses="LabelSecondaryColor"/>
            <SpinBox MinSize="100 0" Name="BottleDosage" Access="Public" Value="0"/>
            <Button MinSize="80 0" Name="CreateBottleButton" Access="Public" Text="{Loc 'chem-master-window-create-button'}"/>
          </BoxContainer>
        </BoxContainer>
      </PanelContainer>
    </BoxContainer>
    <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
      <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="5" SeparationOverride="10">
        <BoxContainer Orientation="Horizontal">
          <Label Text="{Loc 'medieval-alchemy-window-inserted-bottles'}"/>
          <Control HorizontalExpand="True"/>
          <Label Name="BottleCountLabel" Text="0 / 9"/>
        </BoxContainer>
        <PanelContainer MinSize="0 230">
          <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#1B1B1E"/>
          </PanelContainer.PanelOverride>
          <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="4" SeparationOverride="8">
              <Label Text="{Loc 'medieval-alchemy-window-potion-bottles'}"/>
              <BoxContainer Name="BottleList" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="5">
                <Label Text="{Loc 'medieval-alchemy-window-no-bottles'}"/>
              </BoxContainer>
              <BoxContainer Orientation="Horizontal">
                <Label Text="{Loc 'medieval-alchemy-window-bolus-bottle'}"/>
                <Control HorizontalExpand="True"/>
                <Label Name="BolusBottleCountLabel" Text="0 / 1"/>
              </BoxContainer>
              <BoxContainer Name="BolusBottleInfo" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="5">
              <Label Text="{Loc 'medieval-alchemy-window-no-bolus-bottle'}"/>
              </BoxContainer>
            </BoxContainer>
          </ScrollContainer>
        </PanelContainer>
        <Label Text="{Loc 'medieval-alchemy-window-potion-packaging'}"/>
        <PanelContainer>
          <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#1B1B1E"/>
          </PanelContainer.PanelOverride>
          <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="8" SeparationOverride="8">
            <BoxContainer Orientation="Horizontal">
              <Label Text="{Loc 'medieval-alchemy-window-potion-dosage'}"/>
              <Control HorizontalExpand="True"/>
              <BoxContainer Orientation="Horizontal" SeparationOverride="2">
                  <Button Name="BottlePotionMinusButton" Text="-" MinSize="28 0"/>
                  <LineEdit Name="BottlePotionDosage" Access="Public" MinSize="85 0" Text="5.00"/>
                  <Button Name="BottlePotionPlusButton" Text="+" MinSize="28 0"/>
              </BoxContainer>
            </BoxContainer>
            <BoxContainer Orientation="Horizontal">
              <Label Text="{Loc 'medieval-alchemy-window-water-per-bottle'}"/>
              <Control HorizontalExpand="True"/>
              <BoxContainer Orientation="Horizontal" SeparationOverride="2">
                <Button Name="BottleWaterMinusButton" Text="-" MinSize="28 0"/>
                <LineEdit Name="BottleWaterDosage" Access="Public" MinSize="85 0" Text="0.00"/>
                <Button Name="BottleWaterPlusButton" Text="+" MinSize="28 0"/>
              </BoxContainer>
            </BoxContainer>
            <Label Text="{Loc 'medieval-alchemy-window-select-bottles'}"/>
            <GridContainer Columns="9" HorizontalExpand="True">
              <Button Name="BottleSlot1Button" Text="1" ToggleMode="True" Disabled="True" MinSize="42 30"/>
              <Button Name="BottleSlot2Button" Text="2" ToggleMode="True" Disabled="True" MinSize="42 30"/>
              <Button Name="BottleSlot3Button" Text="3" ToggleMode="True" Disabled="True" MinSize="42 30"/>
              <Button Name="BottleSlot4Button" Text="4" ToggleMode="True" Disabled="True" MinSize="42 30"/>
              <Button Name="BottleSlot5Button" Text="5" ToggleMode="True" Disabled="True" MinSize="42 30"/>
              <Button Name="BottleSlot6Button" Text="6" ToggleMode="True" Disabled="True" MinSize="42 30"/>
              <Button Name="BottleSlot7Button" Text="7" ToggleMode="True" Disabled="True" MinSize="42 30"/>
              <Button Name="BottleSlot8Button" Text="8" ToggleMode="True" Disabled="True" MinSize="42 30"/>
              <Button Name="BottleSlot9Button" Text="9" ToggleMode="True" Disabled="True" MinSize="42 30"/>
            </GridContainer>
            <BoxContainer Orientation="Horizontal">
              <Label Text="{Loc 'medieval-alchemy-window-label'}"/>
              <Control HorizontalExpand="True"/>
              <LineEdit Name="BottleLabelLine" Access="Public" MinSize="200 0"/>
            </BoxContainer>
            <BoxContainer Orientation="Horizontal">
              <Control HorizontalExpand="True"/>
              <Button Name="FillBottlesButton" Access="Public" Text="{Loc 'medieval-alchemy-window-fill-selected-bottles'}" MinSize="150 0" Disabled="True"/>
            </BoxContainer>
          </BoxContainer>
        </PanelContainer>
        <Label Text="{Loc 'medieval-alchemy-window-bolus-production'}"/>
        <PanelContainer>
          <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#1B1B1E"/>
          </PanelContainer.PanelOverride>
          <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="8" SeparationOverride="8">
            <BoxContainer Orientation="Horizontal">
              <Label Text="{Loc 'medieval-alchemy-window-bolus-appearance'}"/>
              <Control HorizontalExpand="True"/>
              <GridContainer Name="BolusAppearanceGrid" Columns="5"/>
            </BoxContainer>
            <BoxContainer Orientation="Horizontal">
              <Label Text="{Loc 'medieval-alchemy-window-potion-dosage'}"/>
              <Control HorizontalExpand="True"/>
              <BoxContainer Orientation="Horizontal" SeparationOverride="2">
                  <Button Name="BolusPotionMinusButton" Text="-" MinSize="28 0"/>
                  <LineEdit Name="BolusPotionDosage" MinSize="85 0" Text="5.00"/>
                  <Button Name="BolusPotionPlusButton" Text="+" MinSize="28 0"/>
              </BoxContainer>
            </BoxContainer>
            <BoxContainer Orientation="Horizontal">
              <Label Text="{Loc 'medieval-alchemy-window-quantity'}"/>
              <Control HorizontalExpand="True"/>
              <SpinBox Name="BolusCount" Access="Public" MinSize="110 0" Value="1"/>
            </BoxContainer>
            <BoxContainer Orientation="Horizontal">
              <Label Text="{Loc 'medieval-alchemy-window-bolus-bottle-label'}"/>
              <Control HorizontalExpand="True"/>
              <LineEdit Name="BolusBottleLabelLine" Access="Public" MinSize="200 0"/>
            </BoxContainer>
            <BoxContainer Orientation="Horizontal">
              <Control HorizontalExpand="True"/>
              <Button Name="CreateBolusButton" Access="Public" Text="{Loc 'medieval-alchemy-window-create-boluses'}" MinSize="130 0" Disabled="True"/>
            </BoxContainer>
          </BoxContainer>
        </PanelContainer>
        <Label Text="{Loc 'medieval-alchemy-window-reservoirs'}"/>
        <PanelContainer>
          <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#1B1B1E"/>
          </PanelContainer.PanelOverride>
          <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="8" SeparationOverride="8">
            <BoxContainer Orientation="Horizontal">
              <Label Text="{Loc 'medieval-alchemy-window-input-beaker'}"/>
              <Control HorizontalExpand="True"/>
              <Label Name="InputBeakerVolumeLabel" Text="-- / --u"/>
            </BoxContainer>
            <BoxContainer Orientation="Horizontal">
              <Label Text="{Loc 'medieval-alchemy-window-storage-buffer'}"/>
              <Control HorizontalExpand="True"/>
              <Label Name="PotionBufferVolumeLabel" Text="-- / --u"/>
            </BoxContainer>
            <BoxContainer Orientation="Horizontal">
              <Label Text="{Loc 'medieval-alchemy-window-water'}"/>
              <Control HorizontalExpand="True"/>
              <Label Name="WaterReservoirLabel" Text="-- / 200u"/>
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" SeparationOverride="8">
              <Label Text="{Loc 'medieval-alchemy-window-nutriment'}"/>
              <Control HorizontalExpand="True"/>
              <Label Name="NutrimentReservoirLabel" Text="-- / 200u"/>
              <Button Name="FillNutrimentButton"
                  Access="Public"
                  Text="{Loc 'medieval-alchemy-window-fill-nutriment'}"
                  MinSize="110 0"
                  Disabled="True"/>
            </BoxContainer>
          </BoxContainer>
        </PanelContainer>
      </BoxContainer>
    </ScrollContainer>
  </TabContainer>
</controls:FancyWindow>
